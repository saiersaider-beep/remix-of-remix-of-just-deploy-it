{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://mbakgylilyuuellifanw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "vinasound-mcp",
      "version": "0.1.0",
      "title": "VinaSound"
    },
    "tools": [
      {
        "name": "search_tracks",
        "title": "Rechercher des morceaux",
        "description": "Recherche des morceaux publiés sur VinaSound par titre, genre ou nom d'artiste. Retourne les métadonnées publiques.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Texte à chercher dans le titre du morceau.",
              "type": "string",
              "minLength": 1
            },
            "genre": {
              "description": "Filtrer par genre exact.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "description": "Nombre maximum de résultats.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_tracks",
        "title": "Mes morceaux",
        "description": "Liste les morceaux de l'artiste connecté (publiés et brouillons). Renvoie titre, statut, lectures et likes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "include_drafts": {
              "default": true,
              "description": "Inclure les brouillons non publiés.",
              "type": "boolean"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_my_wallet",
        "title": "Mon portefeuille",
        "description": "Retourne le solde du portefeuille et les points de fidélité de l'utilisateur connecté sur VinaSound.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
